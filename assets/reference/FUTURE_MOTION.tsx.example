import React from "react";
import { Interactive, staticFile } from "remotion";
import { Video } from "@remotion/media";
import {
  Bot,
  Mail,
  Send,
  ListChecks,
  Receipt,
  Check,
  FileText,
  Folder,
  Landmark,
  CreditCard,
  Play,
  Captions,
  Volume2,
  Scissors,
  Upload,
  Sparkles,
  MessageCircle,
} from "lucide-react";
import { latestRef as r, motionNov as m } from "../../scenes/tokens";
import {
  Stage,
  Heading,
  WindowBar,
  Pointer,
  Link,
  Done,
  Typed,
  Tag,
  surface,
  time,
  ease,
  linear,
  entrance,
} from "./MotionNovKit";
const source = "projects/YOUR_VIDEO/source.mp4";
const abs: React.CSSProperties = { position: "absolute" };

export const FutureMotionAgents = () => {
  const t = time();
  const work = ease(t, 4.8, 5.25),
    summary = ease(t, 9.5, 10);
  const tabs = [
    { Icon: Mail, label: "Переписка" },
    { Icon: ListChecks, label: "Задачи" },
    { Icon: Receipt, label: "Финансы" },
  ];
  const current = t < 6.35 ? 0 : t < 7.85 ? 1 : 2;
  return (
    <Stage>
      <Heading>ОДИН → КОМАНДА</Heading>
      <Interactive.Div
        name="Агент — постоянный центр"
        style={{
          ...abs,
          left: 344 - 280 * work + 280 * summary,
          top: 405 - 190 * ease(t, 0.75, 1.65) + 65 * work - 65 * summary,
          width: 200,
          height: 155,
          ...surface,
          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          justifyContent: "center",
          gap: 12,
          transform: `scale(${0.94 + 0.06 * ease(t, 0.1, 0.5)})`,
          opacity: ease(t, 0, 0.2),
        }}
      >
        <Bot size={62} color={r.purple} />
        <span style={{ fontSize: 27 }}>Мой агент</span>
      </Interactive.Div>
      <svg
        width={888}
        height={800}
        style={{ ...abs, opacity: 1 - work + summary }}
      >
        <Link d="M444 370 C444 425 164 400 164 470" t={t} at={1.9} />
        <Link d="M444 370 L444 470" t={t} at={2.35} />
        <Link d="M444 370 C444 425 724 400 724 470" t={t} at={2.8} />
      </svg>
      {tabs.map(({ Icon, label }, i) => (
        <Interactive.Div
          key={label}
          name={`Инструмент ${label}`}
          style={{
            ...abs,
            left: 54 + i * 280,
            top: 470,
            width: 220,
            height: 185,
            ...surface,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            flexDirection: "column",
            gap: 18,
            ...entrance(t, 2.15 + i * 0.45),
            opacity:
              ease(t, 2.15 + i * 0.45, 2.5 + i * 0.45) * (1 - work + summary),
          }}
        >
          <Icon size={48} color={r.purple} />
          <span style={{ fontSize: 27 }}>{label}</span>
        </Interactive.Div>
      ))}
      <Interactive.Div
        name="Переход к рабочему окну"
        style={{
          ...abs,
          left: 292,
          top: 205,
          width: 550,
          height: 480,
          ...surface,
          opacity: work * (1 - summary),
          transform: `perspective(1600px) rotateY(${-8 * (1 - work)}deg) translateX(${45 * (1 - work) - 55 * summary}px)`,
        }}
      >
        <WindowBar label="Моя команда" icon={<Bot size={25} />} />
        <div style={{ display: "flex", gap: 10, padding: 20 }}>
          {tabs.map(({ Icon, label }, i) => (
            <div
              key={label}
              style={{
                background: i === current ? r.lime : r.paper,
                borderRadius: 12,
                padding: 10,
                display: "flex",
                gap: 8,
                alignItems: "center",
                fontSize: 20,
              }}
            >
              <Icon size={22} />
              {label}
            </div>
          ))}
        </div>
        {current === 0 ? (
          <div style={{ padding: "6px 25px" }}>
            <div style={{ fontSize: 25, color: r.muted }}>
              Когда будет готов проект?
            </div>
            <div
              style={{
                marginTop: 24,
                fontSize: 31,
                lineHeight: 1.3,
                minHeight: 82,
              }}
            >
              <Typed
                text="Отправлю сегодня к вечеру."
                t={t}
                start={5.05}
                end={5.55}
              />
            </div>
            <div
              style={{
                background: t > 6.05 ? r.lilac : r.lime,
                borderRadius: 14,
                padding: 16,
                display: "flex",
                gap: 12,
                fontSize: 25,
                transform: `scale(${1 - 0.03 * Math.sin(Math.PI * linear(t, 5.85, 6.05))})`,
              }}
            >
              {t > 6.05 ? <Check /> : <Send />}
              {t > 6.05 ? "Ответ отправлен" : "Отправить"}
            </div>
            <Pointer x={350} y={300} t={t} at={5.85} />
          </div>
        ) : current === 1 ? (
          <div style={{ padding: 22 }}>
            <div style={{ fontSize: 23, color: r.muted, marginBottom: 18 }}>
              Сегодня
            </div>
            {[
              "Ответить клиенту",
              "Собрать материалы",
              "Подготовить публикацию",
            ].map((text, i) => (
              <div
                key={text}
                style={{
                  display: "flex",
                  gap: 15,
                  alignItems: "center",
                  padding: "11px 0",
                  fontSize: 26,
                  ...entrance(t, 6.4 + i * 0.2),
                }}
              >
                <div
                  style={{
                    width: 27,
                    height: 27,
                    border: `2px solid ${r.line}`,
                    borderRadius: 7,
                    background: t > 6.8 + i * 0.2 ? r.lime : r.white,
                  }}
                >
                  {t > 6.8 + i * 0.2 ? <Check size={24} /> : null}
                </div>
                {text}
              </div>
            ))}
          </div>
        ) : (
          <div style={{ padding: 24 }}>
            <div
              style={{
                display: "flex",
                gap: 24,
                alignItems: "center",
                marginTop: 12,
              }}
            >
              <div
                style={{
                  ...surface,
                  padding: 20,
                  width: 190,
                  transform: `rotate(${-7 + 7 * ease(t, 8.2, 8.75)}deg) translateX(${90 * ease(t, 8.35, 8.95)}px)`,
                  opacity: 1 - ease(t, 8.85, 9.1),
                }}
              >
                <Receipt size={54} color={r.purple} />
                <div style={{ fontSize: 27, marginTop: 14 }}>Сервисы</div>
                <div
                  style={{
                    height: 5,
                    width: 90,
                    background: r.line,
                    marginTop: 15,
                  }}
                />
              </div>
              <Folder size={100} color={r.purple} fill={r.lilac} />
            </div>
            <div
              style={{
                display: "flex",
                alignItems: "center",
                gap: 15,
                fontSize: 28,
                opacity: ease(t, 8.7, 9),
              }}
            >
              <Check />
              Расходы разобраны
            </div>
          </div>
        )}
      </Interactive.Div>
      <Interactive.Div
        name="Включение команды"
        style={{
          ...abs,
          left: 314,
          top: 710,
          width: 260,
          height: 70,
          ...surface,
          display: "flex",
          alignItems: "center",
          justifyContent: "space-around",
          opacity: summary,
        }}
      >
        <span style={{ fontSize: 24 }}>Команда</span>
        <div
          style={{
            width: 76,
            height: 38,
            borderRadius: 50,
            background: t > 10.6 ? r.lime : r.line,
          }}
        >
          <div
            style={{
              width: 30,
              height: 30,
              borderRadius: 50,
              background: r.white,
              margin: 4,
              transform: `translateX(${38 * ease(t, 10.6, 10.85)}px)`,
            }}
          />
        </div>
        <Pointer x={200} y={25} t={t} at={10.6} />
      </Interactive.Div>
      {tabs.map((_, i) => (
        <Interactive.Div
          name={`Результат команды ${i + 1}`}
          key={i}
          style={{
            ...abs,
            left: 76 + i * 280,
            top: 630,
            width: 178,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 9,
            background: r.lime,
            borderRadius: 12,
            padding: 10,
            fontSize: 21,
            ...entrance(t, 11.15 + i * 0.65),
          }}
        >
          <Check size={20} />
          {["Отправлено", "План готов", "Разобрано"][i]}
        </Interactive.Div>
      ))}
    </Stage>
  );
};

export const FutureMotionBank = () => {
  const t = time(),
    q = ease(t, 1.25, 2.15);
  return (
    <Stage>
      <Heading>БАНК В ТЕЛЕФОНЕ</Heading>
      <Interactive.Div
        name="Отделение уходит на второй план"
        style={{
          ...abs,
          left: 90 - 20 * q,
          top: 265 + 90 * q,
          width: 300,
          height: 300,
          ...surface,
          padding: 30,
          transform: `perspective(1500px) rotateY(${-12 * q}deg) scale(${1 - 0.15 * q})`,
          opacity: 1 - 0.65 * q,
        }}
      >
        <Landmark size={90} color={r.purple} />
        <div style={{ fontSize: 31, marginTop: 25 }}>Отделение</div>
        <div
          style={{
            height: 24,
            marginTop: 28,
            borderRadius: 8,
            background: r.lilac,
          }}
        />
        <div
          style={{
            height: 24,
            marginTop: 14,
            borderRadius: 8,
            background: r.line,
          }}
        />
      </Interactive.Div>
      <Interactive.Div
        name="Перевод в приложении"
        style={{
          ...abs,
          left: 485 - 90 * q,
          top: 200,
          width: 292,
          height: 510,
          border: `9px solid ${r.ink}`,
          borderRadius: 42,
          background: r.white,
          boxShadow: m.depthShadow,
          transform: `perspective(1400px) rotateY(${12 * (1 - q)}deg) translateY(${50 * (1 - ease(t, 0.35, 0.9))}px)`,
          opacity: ease(t, 0.35, 0.8),
          overflow: "hidden",
        }}
      >
        <div
          style={{
            background: r.ink,
            width: 100,
            height: 16,
            borderRadius: "0 0 12px 12px",
