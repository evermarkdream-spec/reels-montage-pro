          ...abs,
          left: 135,
          top: 480,
          width: 618,
          height: 210,
          background: r.lilac,
          border: `3px solid ${r.purple}`,
          borderRadius: 26,
          boxShadow: m.depthShadow,
          transform: `perspective(1000px) rotateX(${22 - 16 * q}deg)`,
        }}
      >
        <div
          style={{
            ...abs,
            left: 35,
            top: -25,
            width: 548,
            height: 30,
            borderRadius: 20,
            background: r.ink,
            opacity: q,
          }}
        />
        <div
          style={{
            padding: 28,
            display: "grid",
            gridTemplateColumns: "repeat(10,1fr)",
            gap: 9,
          }}
        >
          {Array.from({ length: 30 }, (_, i) => (
            <div
              key={i}
              style={{
                height: 34,
                display: "grid",
                placeItems: "center",
                fontSize: 17,
                color: r.ink,
                background:
                  Math.floor(t * 7) % 30 === i && t < 3.4 ? r.lime : r.white,
                border: `1px solid ${r.line}`,
                borderRadius: 7 + 12 * q,
                boxShadow: `0 3px 0 ${r.line}`,
                transform: `translateY(${Math.floor(t * 7) % 30 === i && t < 3.4 ? 3 : 0}px)`,
              }}
            >
              {"ЙЦУКЕНГШЩЗФЫВАПРОЛДЖЯЧСМИТЬБЮЭ"[i]}
            </div>
          ))}
        </div>
        <div
          style={{
            width: 200,
            height: 18,
            borderRadius: 10,
            background: r.white,
            margin: "-10px auto",
          }}
        />
      </Interactive.Div>
      <Interactive.Div
        name="Каретка печатной машинки"
        style={{
          ...abs,
          left: 165 - 15 * ease(t, 3.9, 4.7),
          top: 450,
          width: 120,
          height: 8,
          background: r.ink,
          borderRadius: 8,
          opacity: q,
        }}
      />
    </Stage>
  );
};

