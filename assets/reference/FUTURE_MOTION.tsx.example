          </div>
          <div style={{ fontSize: 21, color: r.muted, marginTop: 22 }}>
            Со своего счёта
          </div>
          <div
            style={{
              marginTop: 30,
              padding: 15,
              borderRadius: 15,
              background: r.lime,
              fontSize: 24,
              textAlign: "center",
              transform: `scale(${1 - 0.04 * Math.sin(Math.PI * linear(t, 2.5, 2.75))})`,
            }}
          >
            {t > 2.9 ? "Отправлено" : "Перевести"}
          </div>
          <div
            style={{ display: "flex", justifyContent: "center", marginTop: 12 }}
          >
            <Done at={2.85} size={66} />
          </div>
        </div>
        <Pointer x={185} y={300} t={t} at={2.5} />
      </Interactive.Div>
      <Interactive.Div
        name="Банкомат — самостоятельная операция"
        style={{
          ...abs,
          left: 692,
          top: 425,
          width: 125,
          height: 230,
          background: r.lilac,
          border: `2px solid ${r.line}`,
          borderRadius: 20,
          padding: 16,
          boxSizing: "border-box",
          ...entrance(t, 3.9),
        }}
      >
        <div
          style={{
            background: r.ink,
            height: 76,
            borderRadius: 8,
            display: "grid",
            placeItems: "center",
          }}
        >
          <CreditCard color={r.lime} size={40} />
        </div>
        <div
          style={{
            height: 8,
            background: r.ink,
            marginTop: 24,
            borderRadius: 5,
          }}
        />
        <div
          style={{
            display: "grid",
            gridTemplateColumns: "repeat(3,1fr)",
            gap: 6,
            marginTop: 17,
          }}
        >
          {Array.from({ length: 9 }, (_, i) => (
            <div
              key={i}
              style={{ height: 12, background: r.white, borderRadius: 3 }}
            />
          ))}
        </div>
      </Interactive.Div>
    </Stage>
  );
};

export const FutureMotionReview = () => {
