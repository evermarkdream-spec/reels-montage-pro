const Footage = () => (
  <Video
    src={staticFile(source)}
    muted
    trimBefore={520}
    objectFit="cover"
    style={{ width: "100%", height: "100%" }}
  />
);
export const FutureMotionContent = () => {
  const t = time(),
    editor = ease(t, 2.85, 3.4),
    phone = ease(t, 6.1, 6.75);
  return (
    <Stage>
      <Heading>ОТ ИДЕИ ДО РОЛИКА</Heading>
      <Interactive.Div
        name="Сценарий становится монтажом"
        style={{
          ...abs,
          left: 80 - 35 * editor,
          top: 200,
          width: 728 + 70 * editor,
          height: 485,
          ...surface,
          boxShadow: m.depthShadow,
          transform: `perspective(1700px) rotateY(${-5 * (1 - editor) - 7 * phone}deg) scale(${1 - 0.18 * phone}) translateX(${-40 * phone}px)`,
          transformOrigin: "left center",
          opacity: 1 - 0.18 * phone,
          overflow: "hidden",
        }}
      >
        <WindowBar
          label={editor > 0.5 ? "Мой ролик" : "Сценарий"}
          icon={editor > 0.5 ? <Scissors size={24} /> : <FileText size={24} />}
        />
        {t < 3.25 ? (
          <div style={{ padding: 35 }}>
            <div style={{ fontSize: 20, color: r.muted, letterSpacing: 2 }}>
              МИР ЧЕРЕЗ 10 ЛЕТ
            </div>
            <div style={{ fontSize: 35, lineHeight: 1.35, marginTop: 25 }}>
              <Typed
                text="Что изменят нейросети?"
                t={t}
                start={0.3}
                end={1.5}
              />
            </div>
            <div
              style={{
                fontSize: 27,
                lineHeight: 1.4,
                marginTop: 28,
                background: r.lilac,
                padding: 20,
                borderRadius: 15,
                ...entrance(t, 1.5),
              }}
            >
              Команда агентов.
              <br />
              Контент. Обучение.
            </div>
          </div>
        ) : (
          <>
            <div style={{ display: "flex", height: 220, padding: 18, gap: 18 }}>
              <div
                style={{
                  width: 130,
                  borderRadius: 14,
                  overflow: "hidden",
                  background: r.ink,
                }}
              >
                <Footage />
              </div>
              <div style={{ flex: 1, padding: 10 }}>
                <div style={{ fontSize: 25 }}>Мир через 10 лет</div>
                <div style={{ fontSize: 21, color: r.muted, marginTop: 16 }}>
                  Видео • 9:16
                </div>
                <div style={{ display: "flex", gap: 10, marginTop: 26 }}>
                  <Tag active>
                    <Play size={21} />
                    Предпросмотр
                  </Tag>
                </div>
              </div>
            </div>
            <div style={{ padding: "0 22px", position: "relative" }}>
              <div
                style={{
                  height: 48,
                  borderRadius: 9,
                  background: r.lilac,
                  display: "flex",
                  gap: 6,
                  padding: 5,
                  overflow: "hidden",
                }}
              >
                {[0, 1, 2, 3, 4].map((i) => (
                  <div
                    key={i}
                    style={{
                      flex: 1,
                      borderRadius: 6,
                      background: r.purple,
                      opacity: 0.65,
                      transform: `translateX(${100 * (1 - ease(t, 3.8 + i * 0.09, 4.05 + i * 0.09))}px)`,
                    }}
                  />
                ))}
              </div>
              <div
                style={{
                  height: 36,
                  marginTop: 8,
                  borderRadius: 8,
                  background: r.lime,
                  fontSize: 23,
                  paddingLeft: 12,
                  display: "flex",
                  alignItems: "center",
                  gap: 12,
                  opacity: ease(t, 4.6, 4.85),
                }}
              >
                <Captions size={24} />
                Мир через 10 лет
              </div>
              <div
                style={{
                  display: "flex",
                  alignItems: "center",
                  gap: 3,
                  height: 32,
                  marginTop: 7,
                  opacity: ease(t, 4.85, 5.1),
                }}
              >
                <Volume2 size={23} style={{ marginRight: 8 }} />
                {Array.from({ length: 62 }, (_, i) => (
                  <div
                    key={i}
                    style={{
                      width: 5,
                      height: 6 + 20 * Math.abs(Math.sin(i * 2.4)),
                      background: r.purple,
                      borderRadius: 3,
                    }}
                  />
                ))}
              </div>
              <div
                style={{
                  position: "absolute",
                  top: 0,
                  bottom: -4,
                  left: 24 + 500 * linear(t, 3.9, 6),
                  width: 3,
                  background: r.ink,
                }}
              />
            </div>
          </>
        )}
      </Interactive.Div>
      <Interactive.Div
        name="Публикация того же ролика"
        style={{
          ...abs,
          left: 545,
          top: 185,
          width: 260,
          height: 500,
          border: `9px solid ${r.ink}`,
          borderRadius: 42,
          boxShadow: m.depthShadow,
          overflow: "hidden",
          background: r.ink,
          transform: `perspective(1300px) rotateY(${-14 + 14 * phone}deg) translateX(${60 * (1 - phone)}px)`,
          opacity: phone,
        }}
      >
        <Footage />
        <div
          style={{
            ...abs,
            top: 155,
            left: 15,
            right: 15,
            fontSize: 25,
            fontWeight: 800,
            color: r.white,
            textAlign: "center",
            textShadow: r.captionShadow,
          }}
        >
          МИР ЧЕРЕЗ
          <br />
          10 ЛЕТ
        </div>
        <div
          style={{
            ...abs,
            bottom: 22,
            left: 16,
            right: 16,
            background: r.white,
            borderRadius: 14,
            padding: 12,
            fontSize: 22,
            textAlign: "center",
            color: r.ink,
          }}
        >
          {t > 7.4 ? "Опубликовано" : "Опубликовать"}
        </div>
        <Pointer x={185} y={415} t={t} at={7.1} />
      </Interactive.Div>
      <Interactive.Div
        name="Этапы одного материала"
        style={{ ...abs, left: 75, top: 725, display: "flex", gap: 14 }}
      >
        {[
          { I: FileText, l: "Сценарий", a: 0 },
          { I: Scissors, l: "Монтаж", a: 3.95 },
          { I: Captions, l: "Субтитры", a: 4.6 },
          { I: Upload, l: "Публикация", a: 5.28 },
        ].map(({ I, l, a }) => (
          <div
            key={l}
            style={{
              fontSize: 21,
              display: "flex",
              alignItems: "center",
              gap: 7,
              color: t >= a ? r.ink : r.muted,
            }}
          >
            <I size={24} color={t >= a ? r.purple : r.muted} />
            {l}
          </div>
        ))}
      </Interactive.Div>
    </Stage>
  );
};

