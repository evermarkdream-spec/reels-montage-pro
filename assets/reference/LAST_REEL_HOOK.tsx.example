import { Img, Interactive, staticFile, useCurrentFrame } from "remotion";
import { latestRef as r, depthHook as d } from "../../scenes/tokens";
import { ease, linear } from "./MotionNovKit";

const SolidText = ({
  text,
  color,
  size,
}: {
  text: string;
  color: string;
  size: number;
}) => (
  <div
    style={{
      position: "relative",
      fontFamily: r.titleFont,
      fontWeight: 900,
      fontSize: size,
      lineHeight: 1.12,
      letterSpacing: -3,
      wordSpacing: 8,
      whiteSpace: "nowrap",
      transformStyle: "preserve-3d",
      textAlign: "center",
    }}
  >
    {Array.from({ length: d.extrusion }, (_, i) => {
      const z = d.extrusion - i;
      return (
        <div
          key={i}
          aria-hidden
          style={{
            position: "absolute",
            inset: 0,
            color: z > 7 ? d.side : d.sideLight,
            transform: `translate3d(${z * 0.32}px,${z * 0.55}px,${-z}px)`,
          }}
        >
          {text}
        </div>
      );
    })}
    <div
      style={{
        position: "relative",
        color,
        transform: "translateZ(1px)",
        textShadow: `0 -1px 0 ${r.white}`,
      }}
    >
      {text}
    </div>
  </div>
);
export const FirstOrderHook = () => {
  const f = useCurrentFrame(),
    t = f / 25;
  if (f >= 160) return null;
  const mask = staticFile(
    `test-order-nov5/occlusion/bg-${String(f).padStart(3, "0")}.png`,
  );
  const q = ease(t, 0, 0.65),
    leave = 1 - ease(t, 6.0, 6.4),
    drift = linear(t, 0.65, 6.0);
  return (
    <>
      <Img
        src={mask}
        style={{
          position: "absolute",
          width: 1,
          height: 1,
          opacity: 0,
          pointerEvents: "none",
        }}
      />
      <Interactive.Div
        name="Хук • за силуэтом автора"
        from={0}
        durationInFrames={160}
        style={{
          position: "absolute",
          inset: 0,
          zIndex: 4,
          maskImage: `url("${mask}")`,
          WebkitMaskImage: `url("${mask}")`,
          maskSize: "1080px 1920px",
          WebkitMaskSize: "1080px 1920px",
          maskRepeat: "no-repeat",
          WebkitMaskRepeat: "no-repeat",
          maskMode: "alpha",
          opacity: leave,
          perspective: d.perspective,
          perspectiveOrigin: "540px 380px",
        }}
      >
        <Interactive.Div
          name="Хук • объёмный заголовок"
          style={{
            position: "absolute",
            top: 235,
            left: 96,
            width: 650,
            textAlign: "center",
            transformStyle: "preserve-3d",
            transform: `translate3d(${-26 * (1 - q) + 8 * drift}px,${28 * (1 - q) - 4 * drift}px,${-160 * (1 - q)}px) rotateX(${9 - 5 * q}deg) rotateY(${-13 + 10 * q + 4 * drift}deg)`,
            opacity: q,
            filter: `drop-shadow(${d.shadow})`,
          }}
        >
          <div
            style={{
              fontFamily: r.font,
              fontWeight: 700,
              fontSize: 27,
              letterSpacing: 3,
              transform: "translateY(10px)",
              color: r.white,
              marginBottom: 14,
            }}
          >
            КОНТЕНТ С ПОМОЩЬЮ ИИ
          </div>
          <SolidText text="ПЕРВЫЙ" color={r.white} size={82} />
          <div style={{ marginTop: 4 }}>
            <SolidText text="ЗАКАЗ" color={r.lime} size={112} />
          </div>
        </Interactive.Div>
      </Interactive.Div>
    </>
  );
};
