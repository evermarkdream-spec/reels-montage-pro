import React from "react";
import {
  Easing,
  interpolate,
  useCurrentFrame,
  useVideoConfig,
  Interactive,
  Sequence,
} from "remotion";
import { Lottie } from "@remotion/lottie";
import { Check, MousePointer2 } from "lucide-react";
import { latestRef as r, motionNov as m } from "../../scenes/tokens";
export const time = () => useCurrentFrame() / useVideoConfig().fps;
export const linear = (t: number, a: number, b: number) =>
  Math.max(0, Math.min(1, (t - a) / (b - a)));
export const ease = (t: number, a: number, b: number) =>
  interpolate(t, [a, b], [0, 1], {
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp",
    easing: Easing.bezier(0.16, 1, 0.3, 1),
  });
export const entrance = (t: number, a: number) => {
  const q = ease(t, a, a + m.entranceSeconds);
  return {
    opacity: q,
    transform: `translateY(${24 * (1 - q)}px) scale(${0.94 + 0.06 * q})`,
    filter: `blur(${5 * (1 - q)}px)`,
  };
};
export const surface: React.CSSProperties = {
  background: r.white,
  border: `${m.border}px solid ${r.line}`,
  borderRadius: m.panelRadius,
  boxShadow: m.softShadow,
  boxSizing: "border-box",
};
export const Stage = ({ children }: { children: React.ReactNode }) => (
  <div
    style={{
      position: "relative",
      width: m.width,
      height: m.height,
      color: r.ink,
      fontFamily: r.font,
      fontWeight: 600,
    }}
  >
    {children}
  </div>
);
export const Heading = ({ children }: { children: React.ReactNode }) => (
  <div
    style={{
      position: "absolute",
      left: 24,
      top: 62,
      width: 840,
      fontFamily: r.titleFont,
      fontWeight: 900,
      fontSize: m.titleSize,
      lineHeight: 1.16,
      letterSpacing: -1.5,
      textAlign: "center",
    }}
  >
    {children}
  </div>
);
export const WindowBar = ({
  label,
  icon,
}: {
  label: string;
  icon?: React.ReactNode;
}) => (
  <div
    style={{
      display: "flex",
      alignItems: "center",
      gap: 12,
      height: 56,
      borderBottom: `1px solid ${r.line}`,
      padding: "0 22px",
      fontSize: m.labelSize,
    }}
  >
    {icon}
    <span>{label}</span>
    <div style={{ marginLeft: "auto", display: "flex", gap: 6 }}>
      {[0, 1, 2].map((k) => (
        <span
          key={k}
          style={{ width: 7, height: 7, borderRadius: 10, background: r.line }}
        />
      ))}
    </div>
  </div>
);
export const Link = ({ d, t, at }: { d: string; t: number; at: number }) => (
  <path
    d={d}
    fill="none"
    stroke={r.purple}
    strokeWidth={4}
    pathLength={1}
    strokeDasharray={1}
    strokeDashoffset={1 - ease(t, at, at + 0.65)}
    strokeLinecap="round"
  />
);
export const Pointer = ({
  x,
  y,
  t,
  at,
}: {
  x: number;
  y: number;
  t: number;
  at: number;
}) => {
  const q = ease(t, at - 0.45, at),
    press = linear(t, at, at + 0.24);
  return (
    <div
      style={{
        position: "absolute",
        left: x + 70 * (1 - q),
        top: y + 60 * (1 - q),
        opacity: ease(t, at - 0.5, at - 0.3) * (1 - ease(t, at + 0.7, at + 1)),
        transform: `scale(${1 - 0.14 * Math.sin(press * Math.PI)})`,
        color: r.ink,
        zIndex: 10,
      }}
    >
      <MousePointer2 size={40} fill={r.white} />
      <div
        style={{
          position: "absolute",
          left: -12,
          top: -12,
          width: 36,
          height: 36,
          border: `2px solid ${r.purple}`,
          borderRadius: 100,
          opacity: t < at ? 0 : 1 - linear(t, at, at + 0.5),
          transform: `scale(${1 + linear(t, at, at + 0.5)})`,
        }}
      />
    </div>
  );
};
// Original authored Lottie vector ring, no downloaded stock or embedded text.
const rgb = (hex: string) =>
  hex
    .slice(1)
    .match(/../g)!
    .map((x) => parseInt(x, 16) / 255);
const completion = {
  v: "5.12.2",
  fr: 25,
  ip: 0,
  op: 20,
  w: 100,
  h: 100,
  nm: "Completion ring",
  ddd: 0,
  assets: [],
  layers: [
    {
      ddd: 0,
      ind: 1,
      ty: 4,
      nm: "Ring",
      sr: 1,
      ks: {
        o: { a: 0, k: 100 },
        r: { a: 0, k: -90 },
        p: { a: 0, k: [50, 50, 0] },
        a: { a: 0, k: [0, 0, 0] },
        s: { a: 0, k: [100, 100, 100] },
      },
      ao: 0,
      shapes: [
        {
          ty: "el",
          p: { a: 0, k: [0, 0] },
          s: { a: 0, k: [76, 76] },
          nm: "Circle",
        },
        {
          ty: "st",
          c: { a: 0, k: [...rgb(r.purple), 1] },
          o: { a: 0, k: 100 },
          w: { a: 0, k: 4 },
          lc: 2,
          lj: 2,
          nm: "Stroke",
        },
        {
          ty: "tm",
          s: { a: 0, k: 0 },
          e: {
            a: 1,
            k: [
              {
                t: 0,
                s: [0],
                e: [100],
                i: { x: [0.2], y: [1] },
                o: { x: [0.2], y: [0] },
              },
              { t: 16, s: [100] },
            ],
          },
          o: { a: 0, k: 0 },
          m: 1,
        },
      ],
      ip: 0,
      op: 20,
      st: 0,
      bm: 0,
    },
  ],
};
export const Done = ({ at, size = 64 }: { at: number; size?: number }) => {
  const t = time(),
    { fps } = useVideoConfig();
  return (
    <div
      style={{
        position: "relative",
        width: size,
        height: size,
        opacity: ease(t, at, at + 0.15),
      }}
    >
      <Sequence from={Math.round(at * fps)} layout="none">
        <Lottie
          animationData={completion}
          loop={false}
          style={{ width: size, height: size }}
        />
      </Sequence>
      <Check
        size={size * 0.48}
        strokeWidth={3}
        style={{
          position: "absolute",
          left: size * 0.26,
          top: size * 0.26,
          color: r.ink,
          opacity: ease(t, at + 0.2, at + 0.45),
        }}
      />
    </div>
  );
};
export const Typed = ({
  text,
  t,
  start,
  end,
}: {
  text: string;
  t: number;
  start: number;
  end: number;
}) => (
  <>
    {text.slice(0, Math.floor(text.length * linear(t, start, end)))}
    {t >= start && t < end + 0.18 ? (
      <span style={{ color: r.purple }}>|</span>
    ) : null}
  </>
);
export const Tag = ({
  children,
  active = false,
}: {
  children: React.ReactNode;
  active?: boolean;
}) => (
  <div
    style={{
      padding: "9px 15px",
      background: active ? r.lime : r.lilac,
      borderRadius: m.controlRadius,
      fontSize: m.labelSize,
      display: "inline-flex",
      alignItems: "center",
      gap: 9,
    }}
  >
    {children}
  </div>
);
export const MotionObject = Interactive.Div;
