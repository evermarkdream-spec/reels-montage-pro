        <div
          style={{
            ...abs,
            right: 22,
            bottom: 25,
            padding: 13,
            borderRadius: 15,
            background: r.lime,
          }}
        >
          <Send size={26} />
        </div>
        <Pointer x={695} y={105} t={t} at={2.1} />
      </Interactive.Div>
      {[2, 1].map((i) => (
        <div
          key={i}
          style={{
            ...abs,
            left: 110 + i * 8,
            top: 400 + i * 11,
            width: 668,
            height: 270,
            ...surface,
            background: r.lilac,
            opacity: show,
            transform: `rotate(${i * 1.8}deg)`,
          }}
        />
      ))}
      <Interactive.Div
        name="Документ — выделение и точечная правка"
        style={{
          ...abs,
          left: 110,
          top: 400,
          width: 668,
          height: 270,
          ...panel,
          opacity: show,
          transform: `translateY(${45 * (1 - show)}px) perspective(1500px) rotateX(${12 * (1 - show)}deg)`,
        }}
      >
        <WindowBar
          label={t > 3.9 ? "Проверено" : "Черновик"}
          icon={t > 3.9 ? <Check size={25} /> : <FileText size={25} />}
        />
        <div style={{ padding: "24px 30px", fontSize: 31, lineHeight: 1.5 }}>
          <div
            style={{
              height: 48 * (1 - edited),
              overflow: "hidden",
              opacity: 1 - edited,
            }}
          >
            <span
              style={{
                background: t > 2.85 ? r.lilac : "transparent",
                textDecoration: t > 3.18 ? "line-through" : "none",
              }}
            >
              Очень важный совет:
            </span>
          </div>
          <div style={{ transform: `translateY(${8 * edited}px)` }}>
            <span style={{ background: t > 3.75 ? r.lime : "transparent" }}>
              Начни с вопроса аудитории.
            </span>
          </div>
        </div>
        <Pointer x={300} y={100} t={t} at={2.92} />
        <div style={{ ...abs, right: 25, bottom: 15 }}>
          <Done at={3.85} size={58} />
        </div>
      </Interactive.Div>
    </Stage>
  );
};

const Wave = ({ t, compact = false }: { t: number; compact?: boolean }) => (
  <svg viewBox="0 0 520 44" width="100%" height={compact ? 30 : 44}>
    {Array.from({ length: 90 }, (_, i) => {
      const h = 5 + 31 * Math.abs(Math.sin(i * 1.72) * Math.cos(i * 0.24));
      return (
        <rect
          key={i}
          x={i * 5.75}
          y={(44 - h) / 2}
          width={3.3}
          height={h}
          rx={1.5}
          fill={i / 90 < linear(t, 0, 3) ? r.purple : r.line}
        />
      );
    })}
  </svg>
);

export const FutureCinemaContent = () => {
  const t = time(),
    fan = ramp(t, 0.35, 1.3),
    scatter = ramp(t, 1.6, 2.45),
    assembly = ramp(t, 2.6, 3.25),
    phone = ramp(t, 5.25, 5.95),
    push = ramp(t, 6.9, 8.5);
  const tiles = [
    { x: 105, y: 220, rot: -12, I: FileText, label: "Сценарий" },
    { x: 580, y: 200, rot: 10, I: Captions, label: "Субтитры" },
    { x: 70, y: 490, rot: -6, I: Volume2, label: "Звук" },
    { x: 590, y: 490, rot: 12, I: Scissors, label: "Монтаж" },
  ];
  return (
    <Stage>
      <Heading>ОТ ИДЕИ ДО РОЛИКА</Heading>
      <div
        style={{
          ...abs,
          inset: 0,
          perspective: c.perspective,
          opacity: 1 - ramp(t, 3.05, 3.35),
        }}
      >
        <Interactive.Div
          name="Исходный кадр — центр коллажа"
          style={{
            ...abs,
            left: mix(310, 573, assembly),
            top: mix(210, 263, assembly),
            width: mix(268, 240, assembly),
            height: mix(425, 245, assembly),
            borderRadius: 25,
            overflow: "hidden",
            boxShadow: c.objectShadow,
            transform: `scale(${1 - 0.15 * scatter + 0.1 * assembly}) rotateY(${-6 * fan}deg)`,
            zIndex: 2,
          }}
        >
          <Footage />
        </Interactive.Div>
        {tiles.map(({ x, y, rot, I, label }, i) => {
          const a = ramp(t, 0.3 + i * 0.15, 0.85 + i * 0.15),
            q = scatter * (1 - assembly);
          return (
            <Interactive.Div
              key={label}
              name={`Слой ${label} в коллаже`}
              style={{
                ...abs,
                left: mix(
                  mix(330, x, a) + (x < 300 ? -35 : 35) * q,
                  75 + i * 140,
                  assembly,
                ),
                top: mix(mix(340, y, a), 510 + i * 30, assembly),
                width: mix(218, 180, assembly),
                height: mix(165, 46, assembly),
                ...panel,
                padding: 20,
                zIndex: i < 2 ? 1 : 4,
                opacity: a * (1 - assembly),
                transform: `rotate(${rot * a * (1 - assembly)}deg) scale(${1 + 0.2 * q}) translateY(${-25 * q}px)`,
                filter: `blur(${1.8 * Math.sin(q * Math.PI)}px)`,
              }}
            >
              <div
                style={{
                  display: "flex",
                  alignItems: "center",
                  gap: 10,
                  fontSize: 23,
                }}
              >
                <I size={26} color={r.purple} />
                {label}
              </div>
              {i === 0 ? (
                <div style={{ fontSize: 24, lineHeight: 1.3, marginTop: 13 }}>
                  Мир через
                  <br />
                  <b>10 лет</b>
                </div>
              ) : i === 1 ? (
                <div
                  style={{
                    background: r.lime,
                    padding: 10,
                    fontSize: 22,
                    marginTop: 16,
                    borderRadius: 9,
                  }}
                >
                  Что изменится?
                </div>
              ) : i === 2 ? (
                <div style={{ marginTop: 25 }}>
                  <Wave t={t} compact />
                </div>
              ) : (
                <div style={{ display: "flex", gap: 5, marginTop: 23 }}>
                  {[0, 1, 2].map((j) => (
                    <div
                      key={j}
                      style={{
                        width: 48,
                        height: 44,
                        borderRadius: 7,
                        background: j === 1 ? r.purple : r.lilac,
                        border: `1px solid ${r.line}`,
                      }}
                    />
                  ))}
                </div>
              )}
            </Interactive.Div>
          );
        })}
      </div>
      <Interactive.Div
        name="Слои собираются в редактор"
        style={{
          ...abs,
          left: 48,
          top: 185,
          width: 792,
          height: 510,
          ...panel,
          opacity: ramp(t, 2.8, 3.25) * (1 - phone),
          overflow: "hidden",
          transform: `perspective(1700px) rotateX(${15 * (1 - assembly)}deg) rotateY(${-12 * phone}deg) scale(${0.88 + 0.12 * assembly - 0.13 * phone})`,
        }}
      >
        <WindowBar label="Мой ролик" icon={<Scissors size={26} />} />
        <div
          style={{
            ...abs,
            left: 27,
            top: 79,
            width: 410,
            fontSize: 30,
            lineHeight: 1.35,
          }}
        >
          <span style={{ color: r.muted, fontSize: 21 }}>Сценарий</span>
          <div style={{ marginTop: 15 }}>
            <Typed
              text="Что изменится через 10 лет?"
              t={t}
              start={3.1}
              end={3.7}
            />
          </div>
          <div
            style={{
              marginTop: 18,
              fontSize: 23,
              color: r.purple,
              opacity: ramp(t, 3.7, 3.95),
            }}
          >
            ИИ станет частью работы.
          </div>
        </div>
        <div
          style={{
            ...abs,
            right: 27,
            top: 78,
            width: 240,
            height: 245,
            borderRadius: 15,
            overflow: "hidden",
            background: r.ink,
          }}
        >
          <Footage />
          <div
            style={{
              ...abs,
              bottom: 45,
              width: "100%",
              color: r.white,
              fontSize: 19,
              textAlign: "center",
              textShadow: r.captionShadow,
              opacity: ramp(t, 4.64, 4.9),
            }}
          >
            МИР ЧЕРЕЗ 10 ЛЕТ
          </div>
        </div>
        <div style={{ ...abs, left: 26, top: 346, right: 26 }}>
          <div style={{ display: "flex", gap: 7 }}>
            {[0, 1, 2, 3].map((i) => (
              <div
                key={i}
                style={{
                  width: 177,
                  height: 42,
                  background: i % 2 ? r.lilac : r.purple,
                  borderRadius: 8,
                  border: `1px solid ${r.line}`,
                  transform: `translateX(${(i + 1) * 22 * (1 - ramp(t, 4.02, 4.38))}px)`,
                  opacity: ramp(t, 3.95 + i * 0.06, 4.12 + i * 0.06),
                  display: "grid",
                  placeItems: "center",
                }}
              >
                <Play size={21} color={i % 2 ? r.purple : r.white} />
              </div>
            ))}
          </div>
          <div
            style={{
              display: "flex",
              gap: 8,
              marginTop: 8,
              opacity: ramp(t, 4.64, 4.9),
            }}
          >
            {["Мир", "через", "10 лет"].map((s) => (
              <div
                key={s}
                style={{
                  background: r.lime,
                  borderRadius: 6,
                  padding: "4px 20px",
                  fontSize: 20,
                }}
              >
                {s}
              </div>
            ))}
          </div>
          <Wave t={t - 4} compact />
          <div
            style={{
              ...abs,
              top: -8,
              bottom: 0,
              width: 3,
              left: 720 * linear(t, 4.1, 5.3),
              background: r.ink,
            }}
          />
        </div>
      </Interactive.Div>
      <Interactive.Div
        name="Готовый ролик в телефоне — публикация и наезд"
        style={{
          ...abs,
          left: 305 - 45 * push,
          top: 170 - 10 * push,
          width: 278 + 90 * push,
          height: 530 + 50 * push,
          background: r.ink,
          border: `9px solid ${r.ink}`,
          borderRadius: 42,
          overflow: "hidden",
          boxShadow: c.objectShadow,
          opacity: phone,
          transform: `perspective(1400px) rotateY(${17 * (1 - phone) - 3 * push}deg) translateY(${50 * (1 - phone)}px)`,
        }}
      >
        <Footage />
        <div
          style={{
            ...abs,
            top: 0,
            width: 100,
            left: "50%",
            translate: "-50%",
            height: 17,
            borderRadius: "0 0 14px 14px",
            background: r.ink,
          }}
        />
        <div
          style={{
            ...abs,
            top: 50,
            left: 15,
            right: 15,
            color: r.white,
            textShadow: r.captionShadow,
            fontFamily: r.titleFont,
            fontSize: 25,
            fontWeight: 900,
            textAlign: "center",
          }}
        >
          МИР ЧЕРЕЗ
          <br />
          10 ЛЕТ
        </div>
        <div
          style={{
            ...abs,
            left: 14,
            right: 14,
            bottom: 22,
            padding: 14,
            borderRadius: 16,
            background: t > 6.4 ? r.lime : r.white,
            textAlign: "center",
            fontSize: 23,
            display: "flex",
            justifyContent: "center",
            alignItems: "center",
            gap: 8,
          }}
        >
          {t > 6.4 ? <Check size={24} /> : <Upload size={24} />}
          {t > 6.4 ? "Опубликовано" : "Опубликовать"}
        </div>
        <Pointer x={200} y={438} t={t} at={6.15} />
      </Interactive.Div>
      <Interactive.Div
        name="Автоматизация — связь с готовым роликом"
        style={{
          ...abs,
          left: 100,
          top: 350,
          width: 120,
          height: 120,
          ...panel,
          background: r.lilac,
          display: "grid",
          placeItems: "center",
          opacity: ramp(t, 7.2, 7.6),
          transform: `translateX(${25 * (1 - ramp(t, 7.2, 7.6))}px)`,
        }}
      >
        <Bot size={60} color={r.purple} />
      </Interactive.Div>
      <svg width={888} height={800} style={{ ...abs, pointerEvents: "none" }}>
        <path
          d="M220 410 L260 410"
          stroke={r.purple}
          strokeWidth={4}
          pathLength={1}
          strokeDasharray={1}
          strokeDashoffset={1 - ramp(t, 7.6, 8)}
        />
        <circle
          cx={220 + 40 * ramp(t, 7.7, 8.2)}
          cy={410}
          r={5}
          fill={r.purple}
          opacity={ramp(t, 7.6, 7.8) * (1 - ramp(t, 8.1, 8.4))}
        />
      </svg>
    </Stage>
  );
};

export const FutureCinemaTypewriter = () => <FutureMotionTypewriter />;

export const FutureCinemaLearning = () => {
  const t = time(),
    reply = ramp(t, 2.3, 2.9),
    example = ramp(t, 5.3, 6),
    final = ramp(t, 7.4, 8);
  return (
    <Stage>
      <Heading>УЧИТЬСЯ НА ПРИМЕРЕ</Heading>
      <Interactive.Div
        name="Вопрос — ввод и отправка"
        style={{
          ...abs,
          left: 60,
          top: 265 - 95 * reply,
          width: 768,
          height: 150,
          ...panel,
          padding: 25,
          transform: `perspective(1500px) rotateX(${6 * (1 - reply)}deg)`,
        }}
      >
        <div
          style={{
            display: "flex",
            alignItems: "center",
            gap: 12,
            fontSize: 23,
            color: r.muted,
          }}
        >
          <MessageCircle size={24} />
          Мой вопрос
        </div>
        <div style={{ marginTop: 17, fontSize: 30, width: 640 }}>
          <Typed
            text="Как создавать контент для соцсетей?"
            t={t}
            start={0.35}
            end={1.8}
          />
        </div>
        <div
          style={{
            ...abs,
            right: 20,
            bottom: 20,
            padding: 12,
            borderRadius: 14,
            background: r.lime,
          }}
        >
          <Send size={25} />
        </div>
        <Pointer x={705} y={95} t={t} at={2} />
      </Interactive.Div>
      <Interactive.Div
        name="Ответ развивается по шагам"
        style={{
          ...abs,
          left: 75,
          top: 350,
          width: 738,
          height: 280 - 70 * example,
          ...panel,
          opacity: reply,
          transform: `translateY(${35 * (1 - reply)}px)`,
        }}
      >
        <WindowBar
          label="Разберём на одном посте"
          icon={<Sparkles size={25} color={r.purple} />}
        />
        <div style={{ padding: "20px 25px", fontSize: 30, lineHeight: 1.4 }}>
          <div>
            <span style={{ background: t > 3.5 ? r.lime : "transparent" }}>
              <Typed
                text="Выбери вопрос аудитории."
                t={t}
                start={2.65}
                end={3.5}
              />
            </span>
          </div>
          <div style={{ marginTop: 10 }}>
            <Typed
              text="Дай ответ и покажи пример."
              t={t}
              start={3.65}
              end={4.55}
            />
          </div>
        </div>
      </Interactive.Div>
      {[2, 1].map((i) => (
        <div
          key={i}
          style={{
            ...abs,
            left: 105 + i * 9,
            top: 585 + i * 6,
            width: 678,
            height: 170,
            ...surface,
            background: r.lilac,
            opacity: example,
            transform: `rotate(${i * 1.1 * (1 - final)}deg)`,
          }}
        />
      ))}
      <Interactive.Div
        name="Из объяснения собирается конкретный пост"
        style={{
          ...abs,
          left: 105,
          top: 585,
          width: 678,
          height: 170,
          ...panel,
          opacity: example,
          padding: 22,
          transform: `perspective(1600px) rotateX(${12 * (1 - example)}deg) translateY(${35 * (1 - example)}px)`,
        }}
      >
        <div
          style={{
            display: "flex",
            gap: 12,
            alignItems: "center",
            fontSize: 29,
            fontWeight: 800,
          }}
        >
          <FileText size={27} color={r.purple} />
          <Typed text="Как написать пост с ИИ?" t={t} start={5.6} end={6.4} />
        </div>
        <div style={{ marginTop: 13, fontSize: 25, lineHeight: 1.35 }}>
          <Typed text="Укажи тему и аудиторию." t={t} start={6.45} end={7.3} />
          <br />
          <Typed
            text="Добавь свой пример в черновик."
            t={t}
            start={7.45}
            end={8.55}
          />
        </div>
        <div style={{ ...abs, right: 20, top: 95 }}>
          <Done at={8.8} size={54} />
        </div>
      </Interactive.Div>
    </Stage>
  );
};
