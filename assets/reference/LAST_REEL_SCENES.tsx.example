  <>
    <div style={{ fontSize: 23, color: r.muted, marginBottom: 14 }}>
      Когда будет готов проект?
    </div>
    <div
      style={{
        background: r.lilac,
        padding: 18,
        borderRadius: 16,
        fontSize: 29,
        lineHeight: 1.25,
        transform: `translateY(${-16 * ramp(t, 0.65, 1)}px)`,
        opacity: 1 - ramp(t, 0.65, 1),
      }}
    >
      <Typed text="Отправлю сегодня." t={t} start={0} end={0.5} />
    </div>
    <div
      style={{
        ...abs,
        left: 24,
        right: 24,
        top: 135,
        fontSize: 26,
        display: "flex",
        alignItems: "center",
        gap: 12,
        opacity: ramp(t, 0.8, 1.05),
      }}
    >
      <Check color={r.purple} size={29} />
      Ответ отправлен
    </div>
    <div
      style={{
        ...abs,
        right: 25,
        bottom: 22,
        background: r.lime,
        borderRadius: 14,
        padding: "10px 18px",
        opacity: 1 - ramp(t, 0.8, 1),
      }}
    >
      <Send size={26} />
    </div>
    <Pointer x={315} y={178} t={t} at={0.65} />
  </>
);

const MiniTasks = ({ t }: { t: number }) => (
  <>
    {["Ответить клиенту", "Собрать материалы", "Подготовить пост"].map(
      (s, i) => (
        <div
          key={s}
          style={{
            display: "flex",
            gap: 12,
            alignItems: "center",
            marginBottom: 13,
            fontSize: 25,
            opacity: ramp(t, i * 0.14, i * 0.14 + 0.25),
            transform: `translateX(${25 * (1 - ramp(t, i * 0.14, i * 0.14 + 0.4))}px)`,
          }}
        >
          <div
            style={{
              width: 26,
              height: 26,
              flexShrink: 0,
              borderRadius: 8,
              background: t > 0.55 + i * 0.2 ? r.lime : r.paper,
              border: `2px solid ${r.line}`,
            }}
          >
            {t > 0.55 + i * 0.2 && <Check size={22} />}
          </div>
          {s}
        </div>
      ),
    )}
  </>
);

