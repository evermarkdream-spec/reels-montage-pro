              height: 39,
              background: r.purple,
              border: `2px solid ${r.white}`,
              borderRadius: 6,
              transform: `translate(9px,${25 * (1 - ramp(t, 4.25, 4.65))}px) scaleY(${1 - 0.94 * ramp(t, 4.25, 4.65)})`,
              transformOrigin: "top",
              opacity: 1 - ramp(t, 4.65, 4.8),
