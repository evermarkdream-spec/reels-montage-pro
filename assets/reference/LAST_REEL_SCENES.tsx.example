export const FutureCinemaAgents = () => {
  const t = time();
  const spread = ramp(t, 2.6, 3.8),
    work = ramp(t, 4.8, 5.15),
    summary = ramp(t, 9.55, 10.35);
  const tabs = [
    { Icon: Mail, label: "Переписка", at: 5.12 },
    { Icon: ListChecks, label: "Задачи", at: 6.42 },
    { Icon: Receipt, label: "Финансы", at: 7.94 },
  ];
  const active = t < 6.42 ? 0 : t < 7.94 ? 1 : 2;
  return (
    <Stage>
      <Heading>ОДИН → КОМАНДА</Heading>
      <Particles t={t} />
      <div style={{ opacity: spread * (1 - work + summary) }}>
        <Rail d="M444 320 C444 365 165 335 165 420" t={t} at={3} />
        <Rail d="M444 320 L444 420" t={t} at={3.2} />
        <Rail d="M444 320 C444 365 723 335 723 420" t={t} at={3.4} />
      </div>
      <Interactive.Div
        name="Агент собирается из частиц"
        style={{
          ...abs,
          left: 354 - 240 * work * (1 - summary),
          top: mix(400, 170, spread) + 90 * work * (1 - summary),
          width: 180,
          height: 150,
          ...panel,
          background: r.lilac,
          display: "grid",
          placeItems: "center",
          opacity: ramp(t, 1.2, 1.6),
          transform: `perspective(${c.perspective}px) rotateY(${-12 * work * (1 - summary)}deg) scale(${0.82 + 0.18 * ramp(t, 1.2, 1.8)})`,
        }}
      >
        <Bot size={76} strokeWidth={1.7} color={r.purple} />
      </Interactive.Div>
      {tabs.map(({ Icon, label, at }, i) => {
        const focus = work * (1 - summary),
          on = active === i;
        const selected =
          ramp(t, i === 0 ? 4.8 : at - 0.2, at + 0.12) *
          (i < 2
            ? 1 - ramp(t, tabs[i + 1].at - 0.2, tabs[i + 1].at + 0.12)
            : 1);
        const focused = focus * selected;
        const x = mix(55 + i * 278, mix(75 + i * 30, 335, selected), focus);
        const y = mix(420, mix(475 + i * 35, 245, selected), focus);
        const appear = ramp(t, 2.85 + i * 0.25, 3.35 + i * 0.25);
        return (
          <Interactive.Div
            key={label}
            name={`Окно ${label} — действие и результат`}
            style={{
              ...abs,
              left: x,
              top: y,
              width: mix(222, 450, focused),
              height: mix(185, 300, focused),
              ...panel,
              zIndex: on ? 4 : 2,
              opacity: appear * (1 - 0.55 * focus * (1 - selected)),
              transform: `perspective(${c.perspective}px) rotateY(${(i - 1) * -9 * (1 - focus)}deg) translateY(${35 * (1 - appear)}px) scale(${1 - 0.32 * focus * (1 - selected)})`,
              transformOrigin: "center center",
              filter: `blur(${1.5 * focus * (1 - selected)}px)`,
              overflow: "hidden",
            }}
          >
            <div
              style={{
                padding: "19px 20px",
                fontSize: 25,
                display: "flex",
                gap: 12,
                alignItems: "center",
                borderBottom: `1px solid ${r.line}`,
                background: t > at ? r.lilac : r.white,
              }}
            >
              <Icon size={29} color={r.purple} />
              {label}
            </div>
            {focus > 0.9 && on ? (
              <div style={{ padding: 24 }}>
                {i === 0 ? (
                  <MiniMail t={t - at} />
                ) : i === 1 ? (
                  <MiniTasks t={t - at} />
                ) : (
                  <MiniFinance t={t - at} />
                )}
              </div>
            ) : (
              <div
                style={{
                  padding: 23,
                  display: "grid",
                  placeItems: "center",
                  height: 75,
                }}
              >
                {summary > 0.3 ? (
                  <div
                    style={{
                      display: "flex",
                      gap: 8,
                      fontSize: 21,
                      alignItems: "center",
                    }}
                  >
                    <Check size={25} color={r.purple} />
                    {["Отправлено", "План готов", "Разобрано"][i]}
                  </div>
                ) : (
                  <Icon size={46} strokeWidth={1.3} color={r.purple} />
                )}
              </div>
            )}
          </Interactive.Div>
        );
      })}
      <Interactive.Div
        name="Включение команды"
        style={{
          ...abs,
          left: 294,
          top: 660,
          width: 300,
          height: 65,
          borderRadius: 40,
          background: r.ink,
          color: r.white,
          display: "flex",
          gap: 18,
          alignItems: "center",
          justifyContent: "center",
          opacity: ramp(t, 10.4, 10.8),
          transform: `translateY(${18 * (1 - ramp(t, 10.4, 10.8))}px)`,
        }}
      >
        <span style={{ fontSize: 25 }}>Моя команда</span>
        <div
          style={{
            width: 64,
            height: 32,
            borderRadius: 20,
            background: t > 11.2 ? r.lime : r.muted,
          }}
        >
          <div
            style={{
              margin: 4,
              width: 24,
              height: 24,
              borderRadius: 20,
              background: r.white,
              transform: `translateX(${32 * ramp(t, 11.2, 11.5)}px)`,
            }}
          />
        </div>
        <Pointer x={245} y={20} t={t} at={11.2} />
      </Interactive.Div>
      <svg
        width={888}
        height={800}
        style={{ ...abs, pointerEvents: "none", opacity: summary }}
      >
        {[0, 1, 2].map((i) => (
          <circle
            key={i}
            cx={165 + i * 278}
            cy={420 - 64 * ramp(t, 11.6 + i * 0.35, 12.3 + i * 0.35)}
            r={6}
            fill={r.purple}
            opacity={
              ramp(t, 11.6 + i * 0.35, 11.8 + i * 0.35) *
              (1 - ramp(t, 12.1 + i * 0.35, 12.4 + i * 0.35))
            }
          />
        ))}
      </svg>
    </Stage>
  );
};

