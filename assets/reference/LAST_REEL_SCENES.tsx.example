    <Stage>
      <Heading>ЗАДАЧА → ПРОВЕРКА</Heading>
      <Interactive.Div
        name="Ввод и отправка задачи"
        style={{
          ...abs,
          left: 65,
          top: 430 - 240 * show,
          width: 758,
          height: 170,
          ...panel,
          padding: 25,
          transform: `perspective(1500px) rotateX(${4 * (1 - show)}deg)`,
