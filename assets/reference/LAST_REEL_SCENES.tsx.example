          ...abs,
          left: 460 - 70 * q,
          top: 185,
          width: 285,
          height: 520,
          border: `10px solid ${r.ink}`,
          borderRadius: 44,
          boxShadow: c.objectShadow,
          background: r.white,
          overflow: "hidden",
          transform: `perspective(1400px) rotateY(${17 * (1 - q)}deg) translateY(${65 * (1 - ramp(t, 0.15, 0.8))}px)`,
