import React from "react";
import { Interactive, staticFile } from "remotion";
import { Video } from "@remotion/media";
import {
  Bot,
  Mail,
  Send,
  Check,
  ListChecks,
  Receipt,
  Folder,
  FileText,
  Scissors,
  Captions,
  Volume2,
  Play,
  Upload,
  Sparkles,
  MessageCircle,
  CreditCard,
  Landmark,
} from "lucide-react";
import { latestRef as r, cinemaNov as c } from "../../scenes/tokens";
import {
  Stage,
  Heading,
  WindowBar,
  Pointer,
  Done,
  Typed,
  time,
  ease,
  linear,
  surface,
} from "./MotionNovKit";
import { FutureMotionTypewriter } from "./FutureMotionNov";
import botPoints from "./particleBotPoints.json";

const abs: React.CSSProperties = { position: "absolute" };
const source = "projects/YOUR_VIDEO/source.mp4";
const panel: React.CSSProperties = { ...surface, boxShadow: c.objectShadow };
const ramp = (t: number, a: number, b: number) => ease(t, a, b);
const mix = (a: number, b: number, q: number) => a + (b - a) * q;
const Footage = () => (
  <Video
    src={staticFile(source)}
    muted
    objectFit="cover"
    trimBefore={520}
    style={{ width: "100%", height: "100%" }}
  />
);

const Particles = ({ t }: { t: number }) => {
  const gather = ramp(t, 0.25, 1.15);
  return (
    <svg
      width={888}
      height={800}
      style={{ ...abs, opacity: 1 - ramp(t, 1.55, 1.9), pointerEvents: "none" }}
    >
      {Array.from({ length: 240 }, (_, i) => {
        const a = i * 2.399963,
          rr = 85 + ((i * 41) % 190);
        const size = mix(5.8, 76 / 24, ramp(t, 1.15, 1.7));
        const tx = 444 + (botPoints[i][0] - 12) * size;
        const ty = 475 + (botPoints[i][1] - 12) * size;
        const x = mix(444 + Math.cos(a + t * 0.35) * rr, tx, gather);
        const y = mix(455 + Math.sin(a + t * 0.35) * rr * 0.65, ty, gather);
        return (
          <circle
            key={i}
            cx={x}
            cy={y}
            r={1.8 + (i % 3) * 0.5}
            fill={i % 6 === 0 ? r.ink : r.purple}
            opacity={0.3 + 0.7 * ramp(t, 0, 0.5)}
          />
        );
      })}
    </svg>
  );
};

const Rail = ({ d, t, at }: { d: string; t: number; at: number }) => (
  <svg
    width={888}
    height={800}
    style={{ ...abs, inset: 0, pointerEvents: "none" }}
  >
    <path d={d} fill="none" stroke={r.line} strokeWidth={3} />
    <path
      d={d}
      fill="none"
      stroke={r.purple}
      strokeWidth={4}
      pathLength={1}
      strokeDasharray={1}
      strokeDashoffset={1 - ramp(t, at, at + 0.6)}
      strokeLinecap="round"
    />
  </svg>
);

