              borderRadius: 15,
              textAlign: "center",
              fontSize: 24,
            }}
          >
            {t < 3.35 ? "Перевести" : "Отправлено"}
          </div>
          <div style={{ display: "grid", placeItems: "center", marginTop: 12 }}>
            <Done at={3.35} size={66} />
          </div>
        </div>
        <Pointer x={180} y={324} t={t} at={3.08} />
      </Interactive.Div>
      <Interactive.Div
        name="Карта входит в банкомат"
        style={{
          ...abs,
          left: 710,
          top: 425,
          width: 112,
          height: 242,
          ...panel,
          background: r.lilac,
          opacity: atm,
          transform: `translateY(${45 * (1 - atm)}px) perspective(900px) rotateY(-10deg)`,
        }}
      >
        <div
          style={{
            margin: 16,
            height: 77,
            background: r.ink,
            borderRadius: 8,
            display: "grid",
            placeItems: "center",
          }}
        >
          <Check
            size={34}
            color={r.lime}
            style={{ opacity: ramp(t, 4.65, 4.9) }}
          />
        </div>
        <div
          style={{
            margin: "24px 13px",
            height: 7,
            borderRadius: 5,
            background: r.ink,
            overflow: "visible",
